DATABASE_URL=sqlite:///./carpool.db
SECRET_KEY=change-me-later

# Уведомления водителям через сообщение в общую беседу VK (см. ARCHITECTURE.md)
# VK_GROUP_TOKEN/VK_PEER_ID опциональны — без них уведомления просто не отправляются
VK_GROUP_TOKEN=
VK_PEER_ID=
SITE_URL=https://zakaz.glorden.ru/

# Вход через VK ID (OAuth) — отдельно от VK_GROUP_TOKEN/VK_PEER_ID выше (те
# шлют уведомления от сообщества, это — логин людей). Client ID/Secret и
# redirect_uri — из кабинета id.vk.com при регистрации приложения.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://zakaz.glorden.ru/auth/vk/callback

# false — только для локальной отладки, если Secure-cookie почему-то не
# работает на 127.0.0.1. На проде всегда true.
SESSION_COOKIE_SECURE=true
